# 复制为项目根目录的 .env 后填入本地密钥；.env 已被 .gitignore 忽略，不要提交。
# 真实密钥只由后端读取，不进入前端 VITE_*、报告或聊天。
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# F012：HTTP/SSH 隧道用 false；HTTPS 上线后改为 true
HHU_COOKIE_SECURE=false
HHU_SESSION_TTL_DAYS=14
HHU_ALLOWED_ORIGINS=http://127.0.0.1:18080
